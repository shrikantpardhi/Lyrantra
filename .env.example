# Public URL used by canonical tags, sitemaps, and structured data
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL. Leave unset locally to use the non-persistent demonstration catalog.
# For Neon + Vercel, prefer the pooled connection string (*-pooler host).
# Direct (non-pooler) URLs are fine for db:migrate / one-off scripts.
DATABASE_URL=postgres://lyrantra:lyrantra@localhost:5432/lyrantra
DATABASE_SSL=false

# Replace every value before production deployment.
AUTH_SECRET=generate-at-least-32-random-bytes
ENCRYPTION_KEY=generate-a-separate-32-byte-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-password

# Required to run: ALLOW_SEED=true npm run db:seed
# Do not seed production unless you intentionally want demo catalog content.
